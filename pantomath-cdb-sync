#!/bin/sh
# Refreshes Wazuh CDB lists from Pantomath's IOC database, and restarts the
# Wazuh manager only when a list changed (Wazuh reads CDB lists at startup).
# Run on the Wazuh manager as root, for example every 30 minutes from cron:
#   */30 * * * * root PANTOMATH_URL=https://pantomath.example PANTOMATH_KEY=pms_... /usr/local/bin/pantomath-cdb-sync
#
# Lists written (declare each in ossec.conf <ruleset>, see README.md, section 6):
#   etc/lists/pantomath-ip      IPv4 and IPv6
#   etc/lists/pantomath-domain  domains
#   etc/lists/pantomath-url     URLs
#   etc/lists/pantomath-hash    MD5, SHA-1, SHA-256
# Each line is key:confidence. Optional settings:
#   PANTOMATH_MIN_CONFIDENCE  only indicators at least this confident (default 50)
#   PANTOMATH_CA_FILE         CA bundle for Pantomath's certificate
#   PANTOMATH_INSECURE=1      accept a self-signed certificate
set -eu

: "${PANTOMATH_URL:?set PANTOMATH_URL to Pantomath's address}"
: "${PANTOMATH_KEY:?set PANTOMATH_KEY to a SIEM key}"
MIN_CONFIDENCE="${PANTOMATH_MIN_CONFIDENCE:-50}"
WAZUH="${WAZUH_PATH:-/var/ossec}"
LISTS="$WAZUH/etc/lists"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

CURL_TLS=""
[ -n "${PANTOMATH_CA_FILE:-}" ] && CURL_TLS="--cacert $PANTOMATH_CA_FILE"
[ "${PANTOMATH_INSECURE:-0}" = "1" ] && CURL_TLS="--insecure"

changed=0
for pair in ip:ip domain:domain url:url hash:hash; do
    list="${pair%%:*}"
    type="${pair#*:}"
    out="$TMP/pantomath-$list"
    # shellcheck disable=SC2086
    curl -fsS --max-time 300 $CURL_TLS -H "Authorization: Bearer $PANTOMATH_KEY" \
        "${PANTOMATH_URL%/}/api/v1/export?format=cdb&type=$type&min_confidence=$MIN_CONFIDENCE" -o "$out"
    if ! cmp -s "$out" "$LISTS/pantomath-$list"; then
        install -o wazuh -g wazuh -m 660 "$out" "$LISTS/pantomath-$list"
        echo "pantomath-$list: $(wc -l < "$out") entries"
        changed=1
    fi
done

if [ "$changed" = 1 ]; then
    systemctl restart wazuh-manager
    echo "Wazuh manager restarted to load the new lists"
fi
